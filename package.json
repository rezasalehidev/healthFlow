{
  "name": "healthflow",
  "version": "0.1.0",
  "private": true,
  "description": "HealthFlow — production-oriented NestJS microservices backend",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm build:common && pnpm build:redis && pnpm build:messaging && pnpm --filter @healthflow/auth-service build && pnpm --filter @healthflow/api-gateway build && pnpm --filter @healthflow/doctor-service build && pnpm --filter @healthflow/patient-service build && pnpm --filter @healthflow/appointment-service build && pnpm --filter @healthflow/notification-service build",
    "build:common": "pnpm --filter @healthflow/common build",
    "build:redis": "pnpm --filter @healthflow/redis build",
    "build:messaging": "pnpm --filter @healthflow/messaging build",
    "build:auth": "pnpm --filter @healthflow/auth-service prisma:generate && pnpm --filter @healthflow/auth-service build",
    "build:doctor": "pnpm --filter @healthflow/doctor-service prisma:generate && pnpm --filter @healthflow/doctor-service build",
    "build:patient": "pnpm --filter @healthflow/patient-service prisma:generate && pnpm --filter @healthflow/patient-service build",
    "build:appointment": "pnpm --filter @healthflow/appointment-service prisma:generate && pnpm --filter @healthflow/appointment-service build",
    "build:notification": "pnpm --filter @healthflow/notification-service build",
    "build:gateway": "pnpm --filter @healthflow/api-gateway build",
    "lint": "eslint \"{libs,apps/auth-service,apps/api-gateway,apps/doctor-service,apps/patient-service,apps/appointment-service,apps/notification-service}/**/*.ts\" --ignore-pattern \"**/generated/**\"",
    "lint:fix": "eslint \"{libs,apps/auth-service,apps/api-gateway,apps/doctor-service,apps/patient-service,apps/appointment-service,apps/notification-service}/**/*.ts\" --ignore-pattern \"**/generated/**\" --fix",
    "format": "prettier --write \"{apps,libs,docker,proto,docs}/**/*.{ts,json,md,yml,sql,proto}\" \"*.{md,yml}\" \".env.example\"",
    "format:check": "prettier --check \"{apps,libs,docs}/**/*.{ts,json,md}\" \"*.md\"",
    "typecheck": "pnpm --filter @healthflow/common typecheck && pnpm --filter @healthflow/redis typecheck && pnpm --filter @healthflow/messaging typecheck && pnpm --filter @healthflow/auth-service typecheck && pnpm --filter @healthflow/api-gateway typecheck && pnpm --filter @healthflow/doctor-service typecheck && pnpm --filter @healthflow/patient-service typecheck && pnpm --filter @healthflow/appointment-service typecheck && pnpm --filter @healthflow/notification-service typecheck",
    "test": "pnpm test:common && pnpm test:redis && pnpm test:messaging && pnpm test:auth && pnpm test:gateway && pnpm test:doctor && pnpm test:patient && pnpm test:appointment && pnpm test:notification",
    "test:common": "pnpm --filter @healthflow/common test",
    "test:redis": "pnpm --filter @healthflow/redis test",
    "test:messaging": "pnpm --filter @healthflow/messaging test",
    "test:auth": "pnpm --filter @healthflow/auth-service test",
    "test:gateway": "pnpm --filter @healthflow/api-gateway test",
    "test:doctor": "pnpm --filter @healthflow/doctor-service test",
    "test:patient": "pnpm --filter @healthflow/patient-service test",
    "test:appointment": "pnpm --filter @healthflow/appointment-service test",
    "test:notification": "pnpm --filter @healthflow/notification-service test",
    "start:auth": "pnpm --filter @healthflow/auth-service start:dev",
    "start:gateway": "pnpm --filter @healthflow/api-gateway start:dev",
    "start:doctor": "pnpm --filter @healthflow/doctor-service start:dev",
    "start:patient": "pnpm --filter @healthflow/patient-service start:dev",
    "start:appointment": "pnpm --filter @healthflow/appointment-service start:dev",
    "start:notification": "pnpm --filter @healthflow/notification-service start:dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
