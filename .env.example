# Application
NODE_ENV=development
LOG_LEVEL=info

# API Gateway
GATEWAY_PORT=3000

# Auth Service
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_URL=http://localhost:3001
PORT=3001

# Patient Service
PATIENT_SERVICE_PORT=3002
PATIENT_SERVICE_URL=http://localhost:3002

# Doctor Service
DOCTOR_SERVICE_PORT=3003
DOCTOR_SERVICE_URL=http://localhost:3003
DOCTOR_GRPC_BIND=0.0.0.0:50051
DOCTOR_GRPC_URL=localhost:50051
DOCTOR_GRPC_PORT=50051

# Appointment Service
APPOINTMENT_SERVICE_PORT=3004
APPOINTMENT_SERVICE_URL=http://localhost:3004
APPOINTMENT_LOCK_TTL_SECONDS=10
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10

# Notification Service
NOTIFICATION_SERVICE_PORT=3005
NOTIFICATION_SERVICE_URL=http://localhost:3005

# Worker
WORKER_PORT=3006
REMINDER_OFFSETS_HOURS=24,1

# PostgreSQL
POSTGRES_USER=healthflow
POSTGRES_PASSWORD=healthflow
POSTGRES_DB=healthflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://healthflow:healthflow@localhost:5432/healthflow?schema=auth

# MongoDB
MONGO_ROOT_USER=healthflow
MONGO_ROOT_PASSWORD=healthflow
MONGODB_PORT=27017
MONGODB_URI=mongodb://healthflow:healthflow@localhost:27017/healthflow?authSource=admin

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_USER=healthflow
RABBITMQ_PASSWORD=healthflow
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://healthflow:healthflow@localhost:5672

# JWT (generate strong secrets before any real use — never commit real values)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Rate limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Gateway
PROXY_TIMEOUT_MS=10000
BODY_SIZE_LIMIT=1mb

# Doctor cache (seconds)
DOCTOR_CACHE_TTL_SECONDS=300
